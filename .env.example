# Скопируй этот файл в .env (cp .env.example .env) и впиши свои ключи.
# Файл .env в git не попадает (он в .gitignore).

# Apify - сбор рилсов из Instagram.
# Ключ берёшь на https://console.apify.com -> Settings -> API & Integrations -> Personal API tokens.
# Бесплатный план даёт $5 в месяц, этого хватает на несколько прогонов.
APIFY_API_TOKEN=вставь_сюда_свой_ключ_apify

# Можно добавить ещё ключи (например, с других бесплатных аккаунтов):
# скрипт сам возьмёт тот, у которого больше остаток на месяц.
# APIFY_API_TOKEN_2=
# APIFY_API_TOKEN_3=

# Groq - расшифровка речи (Whisper) и разбор хука. Почти бесплатно.
# Ключ берёшь на https://console.groq.com/keys
GROQ_API_KEY=вставь_сюда_свой_ключ_groq
